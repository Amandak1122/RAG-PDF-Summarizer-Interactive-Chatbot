# ==============================================================================
# RAG PDF Summarizer & Chatbot - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Add your Groq API key below.
# 3. Do not commit .env to version control.
# ==============================================================================

# Groq Cloud API Key (Get your free key at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq LLM Model Selection
# Recommended options:
# - qwen/qwen3.8-27b           (Default: Fast inference, strong technical reasoning)
# - llama-3.3-70b-versatile    (High intelligence, deep synthesis)
# - llama-3.1-8b-instant       (Ultra-low latency)
GROQ_MODEL=qwen/qwen3.8-27b

# Local Sentence Transformer Embedding Model (Hugging Face / PyTorch)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Semantic Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Retrieval & Vector Relevance Thresholds
TOP_K_RESULTS=4
SIMILARITY_DISTANCE_THRESHOLD=1.45
SIMILARITY_COSINE_MIN=-0.05

# Server & Cloud Hosting Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=*

# Frontend Backend Connection (Used by Streamlit to reach FastAPI)
# Local: http://127.0.0.1:8000/api
# Cloud: https://<your-backend-service>.onrender.com/api
API_BASE_URL=http://127.0.0.1:8000/api
